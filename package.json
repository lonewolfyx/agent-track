{
    "name": "agent-track",
    "type": "module",
    "version": "0.0.0",
    "packageManager": "pnpm@10.33.0",
    "description": "Lightweight CLI to visualize and trace the execution trajectory of a single agent session",
    "license": "MIT",
    "homepage": "https://github.com/lonewolfyx/agent-track",
    "bugs": {
        "url": "https://github.com/lonewolfyx/agent-track/issues"
    },
    "keywords": [
        "ai",
        "codex",
        "track",
        "agent-track"
    ],
    "bin": {
        "agent-track": "./bin/cli.js",
        "at": "./bin/cli.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "nuxt build && tsdown && rimraf ./dist/nitro.json",
        "dev": "nuxt dev",
        "dev:cli": "tsdown -w",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "typecheck": "nuxt typecheck",
        "lint": "nuxt prepare && eslint .",
        "lint:fix": "nuxt prepare && eslint --fix",
        "prepare": "simple-git-hooks",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@clack/prompts": "^1.5.1",
        "@lucide/vue": "^1.17.0",
        "cac": "^7.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "glob": "^13.0.6",
        "reka-ui": "^2.7.0",
        "vaul-vue": "^0.4.1",
        "vue": "^3.5.26",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.0.0",
        "@nuxt/content": "^3.12.0",
        "@nuxt/eslint": "^1.15.2",
        "@nuxt/icon": "^2.2.1",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^25.9.1",
        "@vueuse/core": "^14.3.0",
        "@vueuse/nuxt": "^14.2.1",
        "eslint": "^10.1.0",
        "jiti": "^2.6.1",
        "nano-staged": "^1.0.2",
        "nuxt": "^4.4.2",
        "nuxt-devkit-server": "^0.0.1",
        "open": "^11.0.0",
        "picocolors": "^1.1.1",
        "rimraf": "^6.1.3",
        "shadcn-nuxt": "~2.4.3",
        "simple-git-hooks": "^2.13.1",
        "skills-config": "^0.0.2",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.3.0",
        "tsdown": "^0.22.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3"
    },
    "simple-git-hooks": {
        "pre-commit": "npx nano-staged",
        "commit-msg": "node scripts/verify-commit.js"
    },
    "nano-staged": {
        "*": "eslint --fix"
    }
}
